# A systemd unit for the daemon.
#
# `hobby daemon &` dies with the shell that started it, which on a box reached
# over ssh means the daemon stops when the connection drops. That is fine for
# trying it out and wrong for a box meant to stay up.
#
#   sudo cp scripts/hobby.service /etc/systemd/system/hobby.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hobby
#   systemctl status hobby
#   journalctl -u hobby -f
#
# Runs as root by default because the daemon talks to the docker socket, which
# on most installs is root-owned. To run as another user, add them to the
# docker group and change User= below.

[Unit]
Description=Hobbyist daemon
Documentation=https://hobbyist.sh/docs/
# Docker is not optional: every resource is a container, so starting before it
# is ready produces a daemon that cannot do the one thing it exists for.
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Environment=HOME=/root
ExecStart=/usr/local/bin/hobby daemon
Restart=on-failure
RestartSec=5s
# The daemon holds long-lived connections it is deliberately slow to drop: it
# drains queues and stops containers in order on shutdown, and killing it
# partway leaves containers running that the store thinks are stopped.
TimeoutStopSec=90
KillSignal=SIGTERM
# Stop versus restart, and the separate proxy process.
#
# The Postgres proxy runs as its own process, spawned by the daemon, so that a
# restart or an upgrade leaves proxied sessions up
# (docs/proxy/specs/2026-11-18-proxy-outlives-the-daemon.md). systemd cannot
# tell the daemon which of `systemctl stop` and `systemctl restart` it is
# doing: a restart is a stop followed by a start, both send the same
# KillSignal, ExecStop= and ExecStopPost= run for both, and nothing passed to
# them names the operation (systemd.service(5), ExecStop=). So:
#
#   systemctl stop hobby      a full stop: the daemon, then the proxy, which
#                             ends its sessions and frees the proxy port.
#   systemctl restart hobby   the same full stop, then a start. Sessions end.
#   hobby daemon restart      the restart that keeps the proxy and its open
#                             sessions: the daemon exits 75 and
#                             RestartForceExitStatus=75 below starts it again,
#                             RestartSec later; the new daemon adopts the proxy.
#   hobby daemon stop         the same full stop as `systemctl stop`.
#
# HOBBY_SIGTERM=stop is what makes a plain SIGTERM the full stop
# (packages/cli/src/daemon/restart-request.ts). Without it SIGTERM keeps the
# proxy running, which under KillMode=process would leave it holding the port
# after `systemctl stop`.
Environment=HOBBY_SIGTERM=stop
RestartForceExitStatus=75
# KillMode=process signals only the daemon. The default control-group would
# also kill the proxy on every exit, including the restart above and a daemon
# crash, where Restart=on-failure brings the daemon back to adopt the proxy
# that is still serving. systemd logs a warning about a left-over process on
# the next start; that process is the proxy, and the daemon adopts it.
KillMode=process

[Install]
WantedBy=multi-user.target
